# SpiceStrong Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to GitHub (contains secrets)

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# EAS Configuration (for building)
EAS_BUILD_PROFILE=production

# Firebase Configuration (if using)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Anthropic Configuration
# Do not expose this as EXPO_PUBLIC_* in the app.
# Store it as a Supabase Edge Function secret:
# supabase secrets set ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Service Role Key (for admin operations - KEEP SECRET)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development/Debug Flags
DEBUG=false
LOG_LEVEL=info
