{
  "cli": {
    "version": ">= 18.2.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMIN_TOOLS": "true",
        "RNFB_SUPPRESS_NEW_ARCHITECTURE_WARNING": "1"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMIN_TOOLS": "true",
        "RNFB_SUPPRESS_NEW_ARCHITECTURE_WARNING": "1"
      }
    },
    "testflight-admin": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMIN_TOOLS": "true",
        "RNFB_SUPPRESS_NEW_ARCHITECTURE_WARNING": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "resourceClass": "large",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_ADMIN_TOOLS": "false",
        "RNFB_SUPPRESS_NEW_ARCHITECTURE_WARNING": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760333811"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
