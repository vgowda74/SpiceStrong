{
  "apps": {
    "ios": {
      "type": "ios.app",
      "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/spicestrong.app",
      "build": "xcodebuild -workspace ios/spicestrong.xcworkspace -scheme spicestrong -configuration Release -sdk iphonesimulator -derivedDataPath ios/build"
    },
    "android": {
      "type": "android.apk",
      "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
      "build": "cd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release"
    }
  },
  "testRunner": "jest",
  "configurations": {
    "ios": {
      "app": "ios",
      "device": {
        "type": "iPhone 14"
      }
    },
    "android": {
      "app": "android",
      "device": {
        "type": "Android"
      }
    }
  },
  "testRunner": "jest"
}
