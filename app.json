{
  "expo": {
    "name": "SpiceStrong",
    "slug": "SpiceStrong",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spicestrong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpiceStrong needs access to your photos for recipe images.",
          "cameraPermission": "SpiceStrong needs camera access to take recipe photos."
        }
      ],
      "expo-speech-recognition"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spicestrong.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "SpiceStrong needs camera access to take recipe photos.",
        "NSPhotoLibraryUsageDescription": "SpiceStrong needs photo library access for recipe images.",
        "NSMicrophoneUsageDescription": "SpiceStrong needs microphone access for voice recipe input.",
        "NSSpeechRecognitionUsageDescription": "SpiceStrong uses speech recognition for hands-free recipe dictation."
      }
    },
    "android": {
      "versionCode": 4,
      "package": "com.spicestrong.app",
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c79b4c1-3bb0-404b-8354-cf7fc38ecf6d"
      }
    }
  }
}
