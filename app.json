{
  "expo": {
    "name": "SpiceStrong",
    "slug": "SpiceStrong",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spicestrong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spicestrong.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "SpiceStrong uses speech recognition to let you describe recipes by voice in the SpiceBuilder.",
        "NSCameraUsageDescription": "SpiceStrong uses the camera to scan nutrition labels, barcodes, restaurant menus, grocery receipts, and your fridge to identify ingredients and add items to your pantry.",
        "NSPhotoLibraryUsageDescription": "SpiceStrong needs access to your photos so you can upload images of nutrition labels, recipes, menus, receipts, and ingredient lists for AI extraction.",
        "NSPhotoLibraryAddUsageDescription": "SpiceStrong saves recipe photos and progress images to your photo library."
      }
    },
    "android": {
      "package": "com.spicestrong.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F0F",
          "dark": {
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c79b4c1-3bb0-404b-8354-cf7fc38ecf6d"
      }
    }
  }
}
