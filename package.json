{
  "name": "spicestrong",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "release": "node ./scripts/release.js",
    "test:e2e:ios": "detox build-framework-cache && detox build-app --configuration ios && detox test e2e/regression.e2e.ts --configuration ios --cleanup",
    "test:e2e:android": "detox build-app --configuration android && detox test e2e/regression.e2e.ts --configuration android --cleanup",
    "test:e2e:ios:debug": "detox build-app --configuration ios && detox test e2e/regression.e2e.ts --configuration ios --record-logs all",
    "test:e2e:android:debug": "detox build-app --configuration android && detox test e2e/regression.e2e.ts --configuration android --record-logs all",
    "test:db:audit": "node scripts/audit-database.js",
    "test:db:audit:watch": "nodemon --exec node scripts/audit-database.js --ext js,ts",
    "test:all": "npm run test:e2e:ios && npm run test:db:audit",
    "android:build": "eas build --platform android --wait",
    "android:submit": "eas submit --platform android --latest",
    "android:release": "node scripts/android-release.js"
  },
  "dependencies": {
    "@expo/ngrok": "^4.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@fal-ai/client": "^1.9.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "~54.0.35",
    "expo-av": "~16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.2",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "detox": "^20.51.3",
    "detox-cli": "^20.51.3",
    "dotenv": "^17.3.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "exceljs": "^4.4.0",
    "jest": "^30.4.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  },
  "private": true
}
